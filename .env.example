# Perfil del laboratorio: unsecure | secure
MEMLAB_PROFILE=unsecure

# Backend del LLM: ollama | stub
#   stub = respondedor deterministico SIN modelo, solo para probar la tuberia.
#          Las corridas con stub quedan marcadas y NO valen como evidencia.
MEMLAB_LLM=ollama

MEMLAB_OLLAMA_HOST=http://localhost:11434
MEMLAB_MODEL=llama3.1:8b-instruct-q4_K_M

# Reproducibilidad (propuesta, seccion 8): temperatura 0 y semilla fija
MEMLAB_SEED=20260919
MEMLAB_TEMPERATURE=0
MEMLAB_NUM_PREDICT=256

MEMLAB_TENANT=eci
MEMLAB_RETRIEVAL_K=4
MEMLAB_DATA_DIR=./data
MEMLAB_EVIDENCE_DIR=./evidence

# Clave HMAC para C4 (firmas de procedencia) y C5 (prueba de borrado).
# NUNCA subir la clave real a git ni mandarla por chat. Generarla localmente:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Exportarla ANTES de correr T01 (lanza un proceso nuevo por sesion: todos
# tienen que ver la misma clave) y las demas corridas oficiales del perfil
# secure. Sin ella se usa una clave de desarrollo fija, valida solo para
# make test y para trabajar con MEMLAB_LLM=stub.
MEMLAB_HMAC_KEY=reemplaza-esto-con-una-clave-aleatoria-de-32-bytes
